{
  "compilerOptions": {
    "experimentalDecorators": true,
    "jsx": "react",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "esModuleInterop": true,
    "declaration": true,
    "downlevelIteration": true,
    "lib": ["es2017", "dom"],
    "types": [
      "mocha",
      "node",
    ]
  },
  "include": ["./src/*"],
  "exclude": ["node_modules", "__tests__/**/*", "examples/**/*", "enzyme.ts"],
}
