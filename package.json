{
  "name": "@alexbruf/react-diff-viewer",
  "version": "3.1.5",
  "private": false,
  "description": "A simple and beautiful text diff viewer component made with diff and React",
  "keywords": [
    "review",
    "code-review",
    "diff",
    "diff-viewer",
    "github",
    "react",
    "react-component",
    "ui"
  ],
  "repository": "git@github.com:alexbruf/react-diff-viewer.git",
  "license": "MIT",
  "author": "Alex Brufsky <alex@brufsky.org>",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "typings": "dist/types/index.d.ts",
  "files": [
    "dist/",
    "package.json",
	"tsconfig.build.json",
	"LICENSE",
	"README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./index.css": {
      "import": "./dist/esm/index.css",
      "require": "./dist/cjs/index.css"
    },
    "./compute-lines": {
      "import": "./dist/esm/compute-lines.js",
      "require": "./dist/cjs/compute-lines.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "compile:css": "sass src/styles.scss > src/styles.css",
    "build": "bun run compile:css && bun run build:cjs && bun run build:esm && bun run build:computelines:cjs && bun run build:computelines:esm && bun run build:types",
    "build:cjs": "bun build src/index.tsx --experimental-css --external=react --target node --outdir dist/cjs --format cjs",
    "build:esm": "bun build src/index.tsx --experimental-css --external=react --target node --outdir dist/esm --format esm",
    "build:computelines:cjs": "bun build src/compute-lines.ts --external=react --target node --outdir dist/cjs --format cjs",
    "build:computelines:esm": "bun build src/compute-lines.ts --external=react --target node --outdir dist/esm --format esm",
    "build:types": "tsc --project tsconfig.build.json --emitDeclarationOnly --outDir dist/types && tsc --project tsconfig.build.json --emitDeclarationOnly --outDir dist/esm && tsc --project tsconfig.build.json --emitDeclarationOnly --outDir dist/cjs",
    "build:examples": "webpack --progress --colors",
    "build:watch": "bun run build:cjs --watch & bun run build:esm --watch & bun run build:types --watch",
    "publish:examples": "NODE_ENV=production yarn build:examples && gh-pages -d examples/dist -r $GITHUB_REPO_URL",
    "publish:examples:local": "NODE_ENV=production yarn build:examples && gh-pages -d examples/dist",
    "start:examples": "vite dev",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "classnames": "^2.2.6",
    "create-emotion": "^10.0.14",
    "diff": "^4.0.1",
    "emotion": "^10.0.14"
  },
  "devDependencies": {
    "@cfaester/enzyme-adapter-react-18": "0.8.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/classnames": "^2.2.6",
    "@types/diff": "^4.0.2",
    "@types/enzyme": "^3.1.14",
    "@types/expect": "^1.20.3",
    "@types/memoize-one": "^4.1.1",
    "@types/mocha": "^5.2.5",
    "@types/node": "^12.0.12",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "bun": "^1.1.10",
    "bun-style-loader": "^0.4.0",
    "cheerio": "^1.0.0-rc.10",
    "css-loader": "^7.1.2",
    "eslint": "^8.0.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.28.0",
    "expect": "^24.8.0",
    "gh-pages": "^2.0.1",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "sass-embedded": "^1.87.0",
    "spy": "^1.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">= 14"
  },
  "resolutions": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0"
  }
}
