{
	"name": "react-diff-viewer",
	"version": "3.1.2",
	"private": false,
	"description": "A simple and beautiful text diff viewer component made with diff and React",
	"keywords": [
		"review",
		"code-review",
		"diff",
		"diff-viewer",
		"github",
		"react",
		"react-component",
		"ui"
	],
	"repository": "git@github.com:alexbruf/react-diff-viewer.git",
	"license": "MIT",
	"author": "Alex Brufsky <alex@brufsky.org>",
	"main": "lib/index",
	"typings": "lib/index",
	"scripts": {
		"build": "tsc --outDir lib/",
		"build:examples": "webpack --progress --colors",
		"build:watch": "tsc --outDir lib/ -w",
		"publish:examples": "NODE_ENV=production yarn build:examples && gh-pages -d examples/dist -r $GITHUB_REPO_URL",
		"publish:examples:local": "NODE_ENV=production yarn build:examples && gh-pages -d examples/dist",
		"start:examples": "webpack-dev-server --open --hot --inline",
		"test": "jest",
		"test:watch": "jest --watch"
	},
	"dependencies": {
		"classnames": "^2.2.6",
		"create-emotion": "^10.0.14",
		"diff": "^4.0.1",
		"emotion": "^10.0.14",
		"memoize-one": "^5.0.4",
		"prop-types": "^15.6.2"
	},
	"devDependencies": {
		"@cfaester/enzyme-adapter-react-18": "0.8.0",
		"@testing-library/jest-dom": "^6.0.0",
		"@testing-library/react": "^14.0.0",
		"@types/classnames": "^2.2.6",
		"@types/diff": "^4.0.2",
		"@types/enzyme": "^3.1.14",
		"@types/expect": "^1.20.3",
		"@types/memoize-one": "^4.1.1",
		"@types/mocha": "^5.2.5",
		"@types/node": "^12.0.12",
		"@types/react": "^18.0.0",
		"@types/react-dom": "^18.0.0",
		"@types/webpack": "^4.4.13",
		"@typescript-eslint/eslint-plugin": "^5.0.0",
		"@typescript-eslint/parser": "^5.0.0",
		"cheerio": "^1.0.0-rc.10",
		"css-loader": "^3.0.0",
		"eslint": "^8.0.0",
		"eslint-config-airbnb": "^19.0.4",
		"eslint-plugin-import": "^2.25.2",
		"eslint-plugin-jsx-a11y": "^6.5.1",
		"eslint-plugin-react": "^7.28.0",
		"expect": "^24.8.0",
		"favicons-webpack-plugin": "^0.0.9",
		"file-loader": "^4.0.0",
		"gh-pages": "^2.0.1",
		"html-webpack-plugin": "^3.2.0",
		"jest": "^29.0.0",
		"jest-environment-jsdom": "^29.0.0",
		"mini-css-extract-plugin": "^0.7.0",
		"raw-loader": "^3.0.0",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"sass": "^1.87.0",
		"sass-loader": "^7.1.0",
		"spy": "^1.0.0",
		"ts-jest": "^29.0.0",
		"ts-loader": "^6.0.4",
		"ts-node": "^8.3.0",
		"typescript": "^4.9.5",
		"webpack": "^4.20.2",
		"webpack-cli": "^3.1.1",
		"webpack-dev-server": "^3.1.9"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"engines": {
		"node": ">= 14"
	},
	"resolutions": {
		"@types/react": "^18.0.0",
		"@types/react-dom": "^18.0.0"
	}
}
